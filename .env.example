# Local settings: copy to .env (docker compose reads it by itself; it never goes to git or into the image).

# Data: sample = the saved copy in tools/sample; auto = the warehouse if configured (see below), else the copy.
SMOGCAST_DATA=sample

# Language model: any OpenAI-compatible endpoint. Values from the shell win over this file.
SMOGCAST_LLM_BASE_URL=BASE-URL
SMOGCAST_LLM_MODEL=MODEL
SMOGCAST_LLM_API_KEY=API-KEY

# The warehouse, for SMOGCAST_DATA=auto or warehouse: the workspace, its SQL Warehouse and the Databricks CLI profile
# that `. tools/dev-env.sh` takes a short-lived token from (the token itself is never written to a file).
DATABRICKS_PROFILE=CLI-PROFILE
DATABRICKS_HOST=https://adb-WORKSPACE.azuredatabricks.net
DATABRICKS_WAREHOUSE_ID=WAREHOUSE-ID
